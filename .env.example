# OpsDesk - copy to .env.local (Vercel: Project Settings > Environment Variables)
# Demo mode works without DATABASE_URL. Production: Neon Postgres URL.
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/opsdesk?sslmode=require"
# Session signing (generate: openssl rand -base64 32). AUTH_SECRET preferred, NEXTAUTH_SECRET also read.
AUTH_SECRET="change-me-in-vercel"
NEXTAUTH_URL="http://localhost:3000"
# Demo password for the three seeded accounts (seeded users use bcrypt of this).
DEMO_PASSWORD="opsdesk123"
